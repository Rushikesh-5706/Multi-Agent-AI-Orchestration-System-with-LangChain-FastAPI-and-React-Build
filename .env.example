# PostgreSQL connection (Docker service hostname: db)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/orchestrator
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=orchestrator

# Redis connection (Docker service hostname: redis)
REDIS_URL=redis://redis:6379/0

# Groq LLM configuration
LLM_API_KEY=your-key-here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=3

# OpenWeather API key (free tier at openweathermap.org)
OPENWEATHER_API_KEY=your-key-here

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Agent and tool limits
MAX_PLAN_STEPS=5
MAX_TOOL_ITERATIONS=4
MAX_TOOL_OUTPUT_CHARS=1500
TOOL_TIMEOUT_SECONDS=45
WORKFLOW_TIMEOUT_SECONDS=300

# Set to a positive integer (e.g. 10) to add a delay inside Celery tool tasks
# Used to test WebSocket liveness during long tool runs
TOOL_SIMULATED_DELAY_SECONDS=0

# WebSocket heartbeat interval in seconds
WS_HEARTBEAT_SECONDS=15

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
